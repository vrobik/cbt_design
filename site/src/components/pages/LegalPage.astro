---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../Eyebrow.astro';
import { dataLunga } from '../../lib/dates';

interface Props {
  id: 'confidentialitate' | 'cookie';
}
const entry = await getEntry('legal', Astro.props.id);
if (!entry) throw new Error(`Lipsește src/content/legal/${Astro.props.id}.md`);
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout title={d.titlu} description={d.descriere}>
  <article class="page page--article">
    <Eyebrow>Legal · actualizat {dataLunga(d.actualizat)}</Eyebrow>
    <h1 class="h1">{d.titlu}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
