---
/** „Cine suntem” (folosită de /despre/ și /ru/despre/). Conținut din CMS → „Pagini → Cine suntem”. */
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../Eyebrow.astro';
import Mosaic from '../Mosaic.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const ro = await getEntry('despre', 'ro');
const ru = await getEntry('despre', 'ru');
if (!ro) throw new Error('Lipsește src/content/despre/ro.md');
const ruTradus = !!(await getEntry('traduceri', 'traduceri'))?.data.despre;
const entry = lang === 'ru' && ruTradus && ru ? ru : ro;
const ruInPregatire = lang === 'ru' && !ruTradus;
// Cât timp traducerea nu e gata, toată interfața rămâne în română (doar comutatorul arată RU).
const ui: Lang = lang === 'ru' && ruTradus ? 'ru' : 'ro';
const c = entry.data;
const { Content } = await render(entry);
---

<BaseLayout
  title={c.seoTitlu}
  description={c.seoDescriere}
  lang={ui}
  comutator={lang}
  image={c.poza}
  imageAlt={c.pozaAlt}
  ruInPregatire={ruInPregatire}
  noindex={ruInPregatire}
  alternate={ruTradus ? { ro: '/despre/', ru: '/ru/despre/' } : undefined}
>
  <article class="page page--about">
    <Eyebrow>{c.eticheta}</Eyebrow>
    <h1 class="h1">{c.titlu}</h1>
    <p class="lead">{c.intro}</p>
    <Mosaic class="mark" />
    <div class="prose muted-prose">
      <Content />
    </div>

    <div class="photo">
      {
        c.poza ? (
          <Image
            src={c.poza}
            alt={c.pozaAlt ?? ''}
            widths={[480, 900, 1400]}
            sizes="(min-width: 964px) 900px, 100vw"
            class="photo-img"
          />
        ) : (
          <span class="photo-label">FOTO · echipa CBT la un eveniment</span>
        )
      }
    </div>

    {
      c.valori.length > 0 && (
        <div class="grid" style="--min:220px">
          {c.valori.map((v) => (
            <div>
              <span class="sq" style={`background:var(--cbt-${v.culoare})`} />
              <h2 class="h3">{v.titlu}</h2>
              <p class="small muted">{v.text}</p>
            </div>
          ))}
        </div>
      )
    }
  </article>
</BaseLayout>

<style>
  .page :global(.mark) {
    margin: 8px 0 var(--sp-4);
  }
  .muted-prose {
    color: var(--cbt-gri-60);
    margin-bottom: var(--sp-5);
  }
  .photo {
    min-height: 280px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--cbt-albastru), var(--cbt-albastru-inchis));
    display: flex;
    align-items: flex-end;
    padding: 20px;
    margin-bottom: 40px;
    overflow: hidden;
    position: relative;
  }
  .photo:has(.photo-img) {
    padding: 0;
    min-height: 0;
  }
  .photo-img {
    width: 100%;
    height: auto;
    display: block;
  }
  .photo-label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: rgba(255, 255, 255, 0.8);
    background: rgba(16, 16, 16, 0.35);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
  }
  .sq {
    display: block;
    width: 12px;
    height: 12px;
    margin-bottom: 10px;
  }
  .small {
    font-size: var(--fs-small);
    margin: 0;
    line-height: 1.55;
  }
</style>
