---
/** Eticheta mono albastră de deasupra titlurilor. */
interface Props {
  as?: 'div' | 'p' | 'span';
}
const { as: Tag = 'div' } = Astro.props;
---

<Tag class="eyebrow"><slot /></Tag>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--cbt-albastru);
    margin: 0 0 var(--sp-2);
  }
</style>
