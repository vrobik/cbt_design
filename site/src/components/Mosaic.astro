---
/**
 * Marker mozaic — pătratele tricolore din logo, semnătura vizuală CBT.
 * Folosit deasupra titlurilor și ca separator. Pur decorativ.
 */
type Culoare = 'albastru' | 'galben' | 'rosu';
interface Props {
  culori?: Culoare[];
  size?: number;
  class?: string;
}
const { culori = ['albastru', 'galben', 'rosu'], size = 12, class: cls } = Astro.props;
---

<div class:list={['mosaic', cls]} aria-hidden="true" style={`--sq:${size}px`}>
  {culori.map((c) => <span style={`background:var(--cbt-${c})`} />)}
</div>

<style>
  .mosaic {
    display: flex;
    gap: 5px;
  }
  .mosaic span {
    width: var(--sq);
    height: var(--sq);
    display: block;
  }
</style>
