---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';

interface Props {
  pr: CollectionEntry<'proiecte'>;
}
const { pr } = Astro.props;
const d = pr.data;
const eticheta = { trecut: 'TRECUT', 'in-desfasurare': 'ÎN DESFĂȘURARE', viitor: 'VIITOR' }[d.stare];
---

<Card href={d.link} hoverable>
  <span class:list={['chip', { 'chip--activ': d.stare !== 'trecut' }]}>{eticheta} · {d.an}</span>
  <h3 class="title">{d.titlu}</h3>
  <p class="desc">{d.descriere}</p>
</Card>

<style>
  .chip {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    color: var(--cbt-gri-60);
    background: var(--cbt-gri-10);
    padding: 3px 9px;
    border-radius: var(--radius-sm);
    margin-bottom: 10px;
  }
  .chip--activ {
    color: var(--cbt-albastru);
    background: var(--cbt-albastru-10);
  }
  .title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
    margin: 0 0 6px;
  }
  .desc {
    color: var(--cbt-gri-60);
    font-size: var(--fs-small);
    margin: 0;
    line-height: 1.55;
  }
</style>
