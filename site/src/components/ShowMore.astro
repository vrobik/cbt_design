---
/**
 * Grilă cu „Arată mai multe”: toate elementele sunt în HTML (bine pentru SEO),
 * dar cu JavaScript activ se văd câte `pas` odată. Fără JS se văd toate.
 *
 * Folosire:
 *   <ShowMore total={lista.length} buton="Arată mai multe evenimente">
 *     {lista.map((x, i) => <div class:list={{ 'more-hidden': i >= 3 }}>…</div>)}
 *   </ShowMore>
 */
import Button from './Button.astro';

interface Props {
  total: number;
  buton: string;
  min?: number;
  pas?: number;
}
const { total, buton, min = 260, pas = 3 } = Astro.props;
---

<div data-more data-pas={pas}>
  <div class="grid" style={`--min:${min}px`} data-more-grid>
    <slot />
  </div>
  <div class="more-btn-wrap" data-has-more={total > pas ? '' : undefined}>
    <Button variant="secondary" type="button" data-more-btn>{buton}</Button>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-more]')) {
    const pas = Number(root.dataset.pas) || 3;
    const btn = root.querySelector<HTMLButtonElement>('[data-more-btn]');
    btn?.addEventListener('click', () => {
      const ascunse = root.querySelectorAll<HTMLElement>('[data-more-grid] > .more-hidden');
      ascunse.forEach((el, i) => {
        if (i < pas) el.classList.remove('more-hidden');
      });
      // Focus pe primul element nou afișat, pentru navigarea cu tastatura.
      ascunse[0]?.querySelector<HTMLElement>('a, button')?.focus({ preventScroll: true });
      if (ascunse.length <= pas) btn.closest<HTMLElement>('.more-btn-wrap')?.removeAttribute('data-has-more');
    });
  }
</script>
