---
/** StatsBand — bandă neagră cu cifre galbene JetBrains Mono. */
interface Props {
  stats: { valoare: string; eticheta: string }[];
}
const { stats } = Astro.props;
---

<dl class="band">
  {
    stats.map((s) => (
      <div>
        <dt class="lbl">{s.eticheta}</dt>
        <dd class="val">{s.valoare}</dd>
      </div>
    ))
  }
</dl>

<style>
  .band {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr));
    gap: var(--sp-4);
    text-align: center;
    background: var(--cbt-negru);
    color: var(--cbt-alb);
    padding: var(--sp-6) var(--sp-4);
    border-radius: var(--radius-lg);
    margin: 0;
  }
  /* Cifra deasupra, eticheta dedesubt (ordinea din HTML rămâne dt → dd). */
  .band > div {
    display: flex;
    flex-direction: column-reverse;
  }
  .val {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: var(--fw-semibold);
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--cbt-galben);
  }
  .lbl {
    font-size: var(--fs-small);
    color: var(--cbt-gri-30);
  }
</style>
