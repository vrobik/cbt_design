---
/**
 * Testimonial — citat scurt, cu poză (dacă există) sau inițiale colorate.
 * Apare pe site doar dacă în CMS e bifat „Acord semnat”.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  t: CollectionEntry<'testimoniale'>;
}
const d = Astro.props.t.data;
const initiale = d.nume
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<figure class="t">
  <blockquote class="q">„{d.citat}”</blockquote>
  <figcaption class="who">
    {
      d.poza ? (
        <Image src={d.poza} alt="" width={44} height={44} densities={[1, 2]} class="avatar" />
      ) : (
        <span class:list={['avatar', `avatar--${d.accent}`]} aria-hidden="true">
          {initiale}
        </span>
      )
    }
    <span>
      <b class="name">{d.nume}</b>
      {d.origine && <small class="origin">{d.origine}</small>}
    </span>
  </figcaption>
</figure>

<style>
  .t {
    background: var(--cbt-alb);
    border-radius: var(--radius-md);
    padding: var(--sp-4);
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .q {
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.55;
    font-weight: var(--fw-medium);
  }
  .who {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }
  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    display: grid;
    place-items: center;
    font-weight: var(--fw-bold);
    color: var(--cbt-alb);
    background: var(--cbt-albastru);
    flex-shrink: 0;
  }
  .avatar--rosu {
    background: var(--cbt-rosu);
  }
  .avatar--galben {
    background: var(--cbt-galben);
    color: var(--cbt-negru);
  }
  .name {
    display: block;
    font-size: var(--fs-small);
  }
  .origin {
    color: var(--cbt-gri-60);
    font-size: var(--fs-label);
  }
</style>
