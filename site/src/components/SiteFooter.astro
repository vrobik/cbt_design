---
import { Image } from 'astro:assets';
import mark from '../assets/brand/mark-white.png';
import { t, type Lang } from '../i18n/ui';
import { setari } from '../lib/content';
import { GA_ID } from '../scripts/analytics';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const s = await setari();
const an = new Date().getFullYear();
---

<footer class="footer">
  <div class="cols">
    <div>
      <Image src={mark} alt="CBT" height={40} densities={[1, 2]} class="mark" />
      <p class="about">{s.descriereScurta}</p>
      <a class="mail" href={`mailto:${s.email}`}>{s.email}</a>
    </div>
    <div>
      <h2 class="h">{tr('footer.navigatie')}</h2>
      <a href={lang === 'ru' ? '/ru/despre/' : '/despre/'}>{tr('nav.despre')}</a>
      <a href="/evenimente/">{tr('nav.evenimente')}</a>
      <a href="/noutati/">{tr('footer.presa')}</a>
      <a href="/contact/">{tr('footer.inscriere')}</a>
    </div>
    <div>
      <h2 class="h">{tr('footer.legal')}</h2>
      <a href="/politica-de-confidentialitate/">{tr('footer.confidentialitate')}</a>
      <a href="/politica-cookie/">{tr('footer.cookie')}</a>
      <a href="/acord-imagine/">{tr('footer.acord')}</a>
      {
        GA_ID && (
          <button type="button" class="linkbtn" data-deschide-cookie>
            {tr('footer.setariCookie')}
          </button>
        )
      }
    </div>
    <div>
      <h2 class="h">{tr('footer.social')}</h2>
      <div class="social">
        {
          s.facebook && (
            <a href={s.facebook} aria-label="Facebook" rel="noopener" target="_blank">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg>
            </a>
          )
        }
        {
          s.instagram && (
            <a href={s.instagram} aria-label="Instagram" rel="noopener" target="_blank">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" /></svg>
            </a>
          )
        }
      </div>
    </div>
  </div>
  <div class="bottom">
    <span>© {an} CBT — {s.numeOrganizatie}</span>
    <span class="domain">basarabenitm.ro</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--cbt-negru);
    color: var(--cbt-gri-30);
    padding: var(--sp-6) clamp(20px, 5vw, 32px) var(--sp-5);
    font-size: var(--fs-small);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--sp-5);
    max-width: var(--container);
    margin: 0 auto;
  }
  .mark {
    height: 40px;
    width: auto;
    display: block;
  }
  .about {
    max-width: 32ch;
    margin: 12px 0 8px;
    line-height: 1.6;
  }
  .h {
    color: var(--cbt-alb);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    margin: 0 0 12px;
  }
  .cols > div > a,
  .linkbtn {
    color: var(--cbt-gri-30);
    text-decoration: none;
    display: block;
    margin-bottom: 8px;
    min-height: 24px;
  }
  .cols > div > a:hover,
  .linkbtn:hover {
    color: var(--cbt-galben);
  }
  .linkbtn {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-size: inherit;
    text-align: left;
  }
  .social {
    display: flex;
    gap: 12px;
  }
  .social a {
    width: 44px;
    height: 44px;
    border: 1px solid var(--cbt-gri-60);
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
    color: var(--cbt-gri-30);
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .social a:hover {
    border-color: var(--cbt-galben);
    color: var(--cbt-galben);
  }
  .bottom {
    max-width: var(--container);
    margin: var(--sp-5) auto 0;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--cbt-gri-90);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
  }
  .domain {
    font-family: var(--font-mono);
  }
</style>
