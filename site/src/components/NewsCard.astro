---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import { dataIso, dataScurta } from '../lib/dates';

interface Props {
  art: CollectionEntry<'noutati'>;
}
const { art } = Astro.props;
const d = art.data;
---

<Card href={`/noutati/${art.id}/`}>
  <span class="meta">
    <time datetime={dataIso(d.data)}>{dataScurta(d.data)}</time>
    {d.tip === 'comunicat' && <span class="tag">Comunicat de presă</span>}
  </span>
  <h3 class="title">{d.titlu}</h3>
  <p class="desc">{d.rezumat}</p>
</Card>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--cbt-gri-60);
  }
  .tag {
    color: var(--cbt-albastru);
    background: var(--cbt-albastru-10);
    padding: 1px 8px;
    border-radius: var(--radius-sm);
  }
  .title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
    margin: 6px 0;
  }
  .desc {
    color: var(--cbt-gri-60);
    font-size: var(--fs-small);
    margin: 0;
    line-height: 1.55;
  }
</style>
