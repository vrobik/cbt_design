---
/**
 * Navigația sticky: logo, 6 linkuri, comutator RO/RU, buton „Înscrie-te”.
 * Sub 820px: hamburger care deschide un panou vertical.
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-color.png';
import Button from './Button.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  comutator: Lang;
  path: string;
  hrefRo: string;
  hrefRu: string;
}
const { lang, comutator, path, hrefRo, hrefRu } = Astro.props;
const tr = t(lang);
const acasa = lang === 'ru' ? '/ru/' : '/';

const items = [
  { href: acasa, label: tr('nav.acasa') },
  { href: lang === 'ru' ? '/ru/despre/' : '/despre/', label: tr('nav.despre') },
  { href: '/proiecte/', label: tr('nav.proiecte') },
  { href: '/evenimente/', label: tr('nav.evenimente') },
  { href: '/noutati/', label: tr('nav.noutati') },
  { href: '/contact/', label: tr('nav.contact') },
];
const activ = (href: string) => (href === acasa ? path === href : path.startsWith(href));
---

<header class="bar">
  <nav class="nav" aria-label={tr('nav.principal')}>
    <a href={acasa} class="logo">
      <Image
        src={logo}
        alt="CBT — Comunitatea Basarabenilor din Timișoara"
        height={36}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <ul class="links">
      {
        items.map((i) => (
          <li>
            <a href={i.href} aria-current={activ(i.href) ? 'page' : undefined}>
              {i.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="right">
      <div class="lang" role="group" aria-label={tr('lang.eticheta')}>
        <a href={hrefRo} hreflang="ro" lang="ro" aria-current={comutator === 'ro' ? 'true' : undefined}>RO</a>
        <a href={hrefRu} hreflang="ru" lang="ru" aria-current={comutator === 'ru' ? 'true' : undefined}>RU</a>
      </div>
      <div class="cta">
        <Button size="sm" href="/contact/" data-track="click_inscriere" data-track-locatie="nav">
          {tr('cta.scurt')}
        </Button>
      </div>
      <button
        type="button"
        class="burger"
        aria-label={tr('nav.meniu')}
        aria-expanded="false"
        aria-controls="meniu-mobil"
        data-burger
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <div class="panel" id="meniu-mobil" hidden>
    {
      items.map((i) => (
        <a href={i.href} aria-current={activ(i.href) ? 'page' : undefined}>
          {i.label}
        </a>
      ))
    }
    <div class="panel-cta">
      <Button href="/contact/" full data-track="click_inscriere" data-track-locatie="nav_mobil">
        {tr('cta.lung')}
      </Button>
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--cbt-alb);
    border-bottom: 1px solid var(--cbt-gri-10);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: clamp(12px, 3vw, 16px) clamp(16px, 4vw, 32px);
    max-width: var(--container);
    margin: 0 auto;
  }
  .logo {
    display: flex;
    flex: none;
  }
  .logo img {
    height: 36px;
    width: auto;
    display: block;
  }
  .links {
    display: flex;
    gap: var(--sp-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links li {
    position: relative;
  }
  .links a {
    text-decoration: none;
    font-size: var(--fs-small);
    color: var(--cbt-gri-90);
    font-weight: var(--fw-medium);
  }
  .links a:hover {
    color: var(--cbt-albastru);
  }
  .links a[aria-current='page'] {
    color: var(--cbt-albastru);
    font-weight: var(--fw-bold);
  }
  /* Marker mozaic galben sub linkul activ. */
  .links a[aria-current='page']::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 10px;
    height: 3px;
    background: var(--cbt-galben);
  }
  .right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }
  .lang {
    display: inline-flex;
    border: 1.5px solid var(--cbt-gri-30);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
  .lang a {
    padding: 6px 13px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    color: var(--cbt-gri-60);
    text-decoration: none;
    line-height: 1.4;
  }
  .lang a:hover {
    color: var(--cbt-albastru);
  }
  .lang a[aria-current='true'] {
    background: var(--cbt-albastru);
    color: var(--cbt-alb);
  }
  .burger {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--cbt-gri-30);
    border-radius: var(--radius-sm);
    background: var(--cbt-alb);
    cursor: pointer;
    padding: 0;
  }
  .burger span {
    width: 18px;
    height: 2px;
    background: var(--cbt-negru);
    display: block;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  .burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  .panel {
    padding: 4px clamp(16px, 4vw, 32px) 16px;
  }
  .panel a:not(.btn) {
    display: block;
    text-decoration: none;
    font-size: var(--fs-body);
    color: var(--cbt-gri-90);
    font-weight: var(--fw-medium);
    padding: 13px 0;
    border-bottom: 1px solid var(--cbt-gri-10);
  }
  .panel a[aria-current='page'] {
    color: var(--cbt-albastru);
    font-weight: var(--fw-bold);
  }
  .panel-cta {
    margin-top: var(--sp-3);
  }

  @media (max-width: 819.98px) {
    .links,
    .cta {
      display: none;
    }
    .burger {
      display: flex;
    }
  }
  @media (min-width: 820px) {
    .panel {
      display: none;
    }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const panel = document.getElementById('meniu-mobil');
  if (burger && panel) {
    const seteaza = (deschis: boolean) => {
      burger.setAttribute('aria-expanded', String(deschis));
      panel.hidden = !deschis;
    };
    burger.addEventListener('click', () => seteaza(panel.hidden === true));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        seteaza(false);
        burger.focus();
      }
    });
  }
</script>
