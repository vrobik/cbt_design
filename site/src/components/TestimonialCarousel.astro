---
/**
 * Carusel testimoniale: 2 pe rând pe desktop, 1 pe mobil, săgeți care se estompează
 * la capete. Fără JavaScript rămâne o bandă care se poate derula cu degetul (scroll-snap).
 */
import type { CollectionEntry } from 'astro:content';
import Eyebrow from './Eyebrow.astro';
import Testimonial from './Testimonial.astro';

interface Props {
  items: CollectionEntry<'testimoniale'>[];
  eticheta: string;
  titlu: string;
}
const { items, eticheta, titlu } = Astro.props;
---

<div class="carousel" data-carousel>
  <div class="head">
    <div>
      <Eyebrow>{eticheta}</Eyebrow>
      <h2 class="h2">{titlu}</h2>
    </div>
    {
      items.length > 1 && (
        <div class="arrows">
          <button type="button" class="arrow" data-prev aria-label="Testimonialul anterior">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button type="button" class="arrow" data-next aria-label="Testimonialul următor">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      )
    }
  </div>
  <ul class="track" data-track-list aria-label={titlu}>
    {
      items.map((t) => (
        <li class="slide">
          <Testimonial t={t} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }
  .h2 {
    margin: 0;
  }
  .arrows {
    display: flex;
    gap: 8px;
    flex: none;
  }
  .arrow {
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1.5px solid var(--cbt-gri-30);
    border-radius: var(--radius-pill);
    background: var(--cbt-alb);
    color: var(--cbt-negru);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease),
      opacity var(--dur-fast) var(--ease);
  }
  .arrow:hover:not([aria-disabled='true']) {
    border-color: var(--cbt-negru);
  }
  .arrow[aria-disabled='true'] {
    opacity: 0.35;
    cursor: default;
  }
  .track {
    --per: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--per) - 1) * var(--sp-4)) / var(--per));
    gap: var(--sp-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 820px) {
    .track {
      --per: 2;
    }
  }
  .slide {
    scroll-snap-align: start;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-track-list]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    if (!prev || !next) continue;

    const pas = () => {
      const slide = track.querySelector<HTMLElement>('.slide');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return (slide?.offsetWidth ?? track.clientWidth) + gap;
    };
    const actualizeaza = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.setAttribute('aria-disabled', String(track.scrollLeft <= 2));
      next.setAttribute('aria-disabled', String(track.scrollLeft >= max));
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -pas() }));
    next.addEventListener('click', () => track.scrollBy({ left: pas() }));
    track.addEventListener('scroll', actualizeaza, { passive: true });
    window.addEventListener('resize', actualizeaza);
    actualizeaza();
  }
</script>
