---
/**
 * Card — suprafața de bază: alb, bordură fină, rază 12px, umbră moale care
 * se ridică și se colorează spre albastru la hover. Cu `href`, tot cardul e link.
 */
interface Props {
  href?: string;
  hoverable?: boolean;
  rezervat?: boolean;
  flush?: boolean;
  class?: string;
}
const { href, hoverable = !!href, rezervat = false, flush = false, class: cls } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={['card', { 'card--hover': hoverable, 'card--rezervat': rezervat, 'card--flush': flush }, cls]}
>
  <slot />
</Tag>

<style>
  .card {
    display: block;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--sp-4);
    box-shadow: var(--shadow-card);
    color: inherit;
    text-decoration: none;
    height: 100%;
    transition:
      box-shadow var(--dur-slow) var(--ease),
      transform var(--dur-slow) var(--ease);
  }
  a.card:hover {
    color: inherit;
  }
  .card--hover:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }
  .card--flush {
    padding: 0;
    overflow: hidden;
  }
  .card--rezervat {
    border: 2px dashed var(--cbt-gri-30);
    box-shadow: none;
  }
</style>
