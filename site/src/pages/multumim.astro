---
/**
 * Pagina de mulțumire după înscriere — cu pasul următor concret (din CMS → Setări).
 * Aici se trimite evenimentul GA4 `sign_up` (conversia).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Mosaic from '../components/Mosaic.astro';
import { setari } from '../lib/content';

const { pasulUrmator: p } = await setari();
---

<BaseLayout
  title="Te-am adăugat pe listă"
  description="Mulțumim că te-ai înscris în Comunitatea Basarabenilor din Timișoara."
  noindex
  conversie="sign_up"
>
  <div class="page page--narrow">
    <Eyebrow>Înscriere</Eyebrow>
    <div class="box">
      <Mosaic size={14} class="mk" />
      <h1 class="h2">Te-am adăugat pe listă! 🎉</h1>
      <p class="lead-sm"><strong>Pasul următor: {p.titlu}.</strong> {p.text}</p>
      <Button variant="dark" href={p.link} target="_blank" rel="noopener">{p.buton}</Button>
    </div>
    <p class="back"><a href="/evenimente/">Vezi evenimentele care urmează →</a></p>
  </div>
</BaseLayout>

<style>
  .box {
    background: var(--cbt-albastru-10);
    border: 1px solid var(--cbt-gri-10);
    border-radius: var(--radius-lg);
    padding: var(--sp-5);
  }
  .box :global(.mk) {
    margin-bottom: var(--sp-3);
  }
  .box .h2 {
    margin-bottom: 12px;
  }
  .lead-sm {
    margin: 0 0 20px;
    line-height: var(--lh-body);
  }
  .back {
    margin-top: var(--sp-4);
    font-size: var(--fs-small);
  }
  .back a {
    font-weight: var(--fw-semibold);
    text-decoration: none;
  }
</style>
