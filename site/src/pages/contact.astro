---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import JoinForm from '../components/forms/JoinForm.svelte';
import { setari } from '../lib/content';

const s = await setari();
---

<BaseLayout
  title="Devino membru · Contact"
  description="Înscrie-te în Comunitatea Basarabenilor din Timișoara: nume, email și, opțional, orașul de origine. Pentru parteneriate, presă sau întrebări, scrie-ne."
>
  <div class="page page--narrow">
    <Eyebrow>Înscriere</Eyebrow>
    <h1 class="h1">Devino membru</h1>
    <p class="muted sub">Doar trei câmpuri. Fără spam — te anunțăm doar la evenimente.</p>

    <JoinForm client:load />

    <section id="scrie-ne" class="write" aria-labelledby="scrie-ne-titlu">
      <Eyebrow as="p">Scrie-ne</Eyebrow>
      <h2 id="scrie-ne-titlu" class="h2">Parteneriate, presă, întrebări</h2>
      <p class="muted">Răspundem de obicei în câteva zile. Pentru presă, materialele sunt și în <a href="/noutati/#press-kit">press kit</a>.</p>
      <ul class="contacts">
        <li>
          <span class="lbl">Email</span>
          <a href={`mailto:${s.email}`}>{s.email}</a>
        </li>
        {
          s.telefon && (
            <li>
              <span class="lbl">Telefon</span>
              <a href={`tel:${s.telefon.replace(/\s/g, '')}`}>{s.telefon}</a>
            </li>
          )
        }
        {
          s.facebook && (
            <li>
              <span class="lbl">Facebook</span>
              <a href={s.facebook} target="_blank" rel="noopener">Pagina CBT ↗</a>
            </li>
          )
        }
        {
          s.instagram && (
            <li>
              <span class="lbl">Instagram</span>
              <a href={s.instagram} target="_blank" rel="noopener">@CBT ↗</a>
            </li>
          )
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .sub {
    margin: 0 0 var(--sp-5);
    line-height: var(--lh-body);
  }
  .write {
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--cbt-gri-10);
  }
  .write .muted {
    margin: 0 0 var(--sp-4);
  }
  .contacts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .contacts li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: baseline;
  }
  .lbl {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--cbt-gri-60);
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow);
    min-width: 96px;
  }
  .contacts a {
    font-weight: var(--fw-semibold);
  }
</style>
