---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Mosaic from '../../components/Mosaic.astro';
import NewsCard from '../../components/NewsCard.astro';
import PressKit from '../../components/PressKit.astro';
import ShowMore from '../../components/ShowMore.astro';
import { noutati } from '../../lib/content';

const lista = await noutati();
---

<BaseLayout
  title="Noutăți & presă"
  description="Noutăți, comunicate de presă și press kit descărcabil al Comunității Basarabenilor din Timișoara — logo-uri high-res și poze de arhivă."
>
  <div class="page page--wide">
    <div class="container">
      <Eyebrow>Noutăți & Presă</Eyebrow>
      <h1 class="h1">Ce mai e nou</h1>
      <p class="intro">Articole, comunicate de presă și press kit descărcabil — logo-uri high-res și poze de arhivă.</p>
      <Mosaic class="lead-mark" />

      {
        lista.length > 0 ? (
          <ShowMore total={lista.length} buton="Arată mai multe" min={280}>
            {lista.map((art, i) => (
              <div class:list={{ 'more-hidden': i >= 3 }}>
                <NewsCard art={art} />
              </div>
            ))}
          </ShowMore>
        ) : (
          <p class="muted">Primele articole apar în curând.</p>
        )
      }

      <PressKit />
    </div>
  </div>
</BaseLayout>

<style>
  .page :global(.lead-mark) {
    margin: var(--sp-4) 0 var(--sp-5);
  }
</style>
