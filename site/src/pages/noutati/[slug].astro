---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Mosaic from '../../components/Mosaic.astro';
import ogDefault from '../../assets/brand/og-default.png';
import logo from '../../assets/brand/logo-color.png';
import { dataIso, dataScurta } from '../../lib/dates';
import { articol } from '../../lib/seo';

export async function getStaticPaths() {
  const toate = await getCollection('noutati', ({ data }) => import.meta.env.DEV || !data.ciorna);
  return toate.map((art) => ({ params: { slug: art.id }, props: { art } }));
}

const { art } = Astro.props as { art: CollectionEntry<'noutati'> };
const d = art.data;
const { Content } = await render(art);
const img = (await getImage({ src: d.imagineOG ?? ogDefault, width: 1200, format: 'jpg' })).src;
---

<BaseLayout
  title={d.seoTitlu ?? d.titlu}
  description={d.seoDescriere ?? d.rezumat}
  image={d.imagineOG}
  imageAlt={d.titlu}
  type="article"
  jsonLd={articol(art, Astro.site, img, logo.src)}
>
  <article class="page page--article">
    <a href="/noutati/" class="back-link">← Înapoi la Noutăți</a>
    <Eyebrow>
      {d.tip === 'comunicat' ? 'Comunicat de presă' : 'Noutăți & Presă'} · <time datetime={dataIso(d.data)}>{dataScurta(d.data)}</time>
    </Eyebrow>
    <h1 class="h1">{d.titlu}</h1>
    <Mosaic class="mark" />
    <p class="lead">{d.rezumat}</p>
    <div class="prose body">
      <Content />
    </div>

    {
      d.fisier && (
        <div class="file">
          <Button variant="secondary" href={d.fisier} download>
            {`Descarcă ${d.tip === 'comunicat' ? 'comunicatul' : 'documentul'} (${(d.fisier.split('.').pop() ?? '').toUpperCase()})`}
          </Button>
        </div>
      )
    }

    <div class="foot">
      Materiale de presă disponibile în <a href="/noutati/#press-kit">press kit</a>.
    </div>
  </article>
</BaseLayout>

<style>
  .page :global(.mark) {
    margin: 0 0 28px;
  }
  .body {
    color: var(--cbt-gri-60);
    margin-bottom: var(--sp-5);
  }
  .file {
    margin-bottom: var(--sp-5);
  }
  .foot {
    border-top: 1px solid var(--cbt-gri-10);
    padding-top: 20px;
    font-size: var(--fs-small);
    color: var(--cbt-gri-60);
  }
  .foot a {
    font-weight: var(--fw-semibold);
  }
</style>
