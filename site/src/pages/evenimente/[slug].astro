---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import ogDefault from '../../assets/brand/og-default.png';
import { dataLunga, dataScurta, esteViitor } from '../../lib/dates';
import { eveniment } from '../../lib/seo';

export async function getStaticPaths() {
  const toate = await getCollection('evenimente', ({ data }) => import.meta.env.DEV || !data.ciorna);
  return toate.map((ev) => ({ params: { slug: ev.id }, props: { ev } }));
}

const { ev } = Astro.props as { ev: CollectionEntry<'evenimente'> };
const d = ev.data;
const { Content } = await render(ev);
const viitor = esteViitor(d.data, d.dataSfarsit);

const interval = d.dataSfarsit ? `${dataScurta(d.data)} – ${dataScurta(d.dataSfarsit)}` : dataScurta(d.data);
const ora = d.ora ? (d.oraSfarsit ? `${d.ora}–${d.oraSfarsit}` : d.ora) : undefined;
const harta = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  [d.locatie, d.adresa, d.locatie.includes(d.oras) ? '' : d.oras].filter(Boolean).join(', '),
)}`;

const imgSchema = d.imagine
  ? (await getImage({ src: d.imagine, width: 1200, format: 'jpg' })).src
  : (await getImage({ src: ogDefault, width: 1200, format: 'jpg' })).src;

// Galeria: miniatură în pagină, poza mare (1600px) deschisă la click.
const galerie = await Promise.all(
  d.galerie.map(async (g) => ({ ...g, mare: (await getImage({ src: g.imagine, width: 1600 })).src })),
);
---

<BaseLayout
  title={d.seoTitlu ?? d.titlu}
  description={d.seoDescriere ?? `${dataLunga(d.data)}${d.ora ? `, ora ${d.ora}` : ''} · ${d.locatie}. ${d.descriere}`}
  image={d.imagine}
  imageAlt={d.imagineAlt ?? d.titlu}
  type="event"
  jsonLd={eveniment(ev, Astro.site, [imgSchema])}
>
  <article class="page page--article ev">
    <a href="/evenimente/" class="back-link">← Înapoi la evenimente</a>

    <div class:list={['hero', `hero--${d.accent}`]}>
      {
        d.imagine && (
          <Image
            src={d.imagine}
            alt={d.imagineAlt ?? ''}
            widths={[480, 760, 1200, 1520]}
            sizes="(min-width: 824px) 760px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="hero-img"
          />
        )
      }
      <span class="chip">{interval}</span>
    </div>

    <Eyebrow>{viitor ? 'Eveniment' : 'Eveniment încheiat'}</Eyebrow>
    <h1 class="h1">{d.titlu}</h1>

    <ul class="chips">
      <li>{interval}</li>
      {ora && <li>ora {ora}</li>}
      <li>{d.locatie}</li>
    </ul>

    <p class="lead">{d.descriere}</p>
    <div class="prose body">
      <Content />
    </div>

    <section class="details" aria-labelledby="detalii">
      <h2 id="detalii" class="h3">Detalii practice</h2>
      <dl class="details-grid">
        <div>
          <dt>Data &amp; ora</dt>
          <dd>{interval}{ora && ` · ${ora}`}</dd>
        </div>
        <div>
          <dt>Locație</dt>
          <dd>
            {d.locatie}
            {d.adresa && <span class="addr">{d.adresa}, {d.oras}</span>}
            <a href={harta} target="_blank" rel="noopener" class="map">Vezi pe hartă ↗</a>
          </dd>
        </div>
        <div>
          <dt>Acces</dt>
          <dd>{d.acces}</dd>
        </div>
      </dl>
    </section>

    <div class="actions">
      {
        viitor && d.linkInscriere && (
          <Button variant="dark" href={d.linkInscriere} target="_blank" rel="noopener">
            Rezervă-ți locul
          </Button>
        )
      }
      {
        viitor && (
          <Button variant="secondary" href={`/evenimente/${ev.id}.ics`} download>
            Adaugă în calendar
          </Button>
        )
      }
    </div>

    {
      d.galerie.length > 0 && (
        <section class="gallery" aria-labelledby="galerie">
          <h2 id="galerie" class="h3">Galerie foto</h2>
          <ul class="gallery-grid">
            {galerie.map((g) => (
              <li>
                <a href={g.mare} target="_blank" rel="noopener">
                  <Image src={g.imagine} alt={g.descriere ?? `Foto de la ${d.titlu}`} width={400} height={300} class="thumb" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="join">
      <p>Vrei să afli primul de următorul eveniment?</p>
      <Button size="lg" href="/contact/" data-track="click_inscriere" data-track-locatie="eveniment">
        Înscrie-te în comunitate
      </Button>
    </div>
  </article>
</BaseLayout>

<style>
  .ev {
    max-width: 824px;
  }
  .hero {
    min-height: 300px;
    border-radius: var(--radius-lg);
    position: relative;
    background: linear-gradient(135deg, var(--cbt-albastru), var(--cbt-albastru-inchis));
    margin-bottom: var(--sp-4);
    overflow: hidden;
  }
  .hero--rosu {
    background: linear-gradient(135deg, var(--cbt-rosu), var(--cbt-rosu-inchis));
  }
  .hero:has(.hero-img) {
    min-height: 0;
  }
  .hero-img {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }
  .chip {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    background: var(--cbt-galben);
    color: var(--cbt-negru);
    font-family: var(--font-mono);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-label);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 var(--sp-4);
    padding: 0;
    list-style: none;
  }
  .chips li {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    background: var(--cbt-gri-10);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
  }
  .body {
    color: var(--cbt-gri-60);
    margin-bottom: var(--sp-5);
  }
  .details {
    background: var(--cbt-albastru-10);
    border-radius: var(--radius-lg);
    padding: var(--sp-4) 28px;
    margin-bottom: var(--sp-5);
  }
  .details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
    gap: var(--sp-3);
    margin: 12px 0 0;
  }
  dt {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--cbt-gri-60);
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow);
    margin-bottom: 4px;
  }
  dd {
    margin: 0;
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
  }
  .addr {
    display: block;
    font-weight: var(--fw-regular);
    color: var(--cbt-gri-60);
  }
  .map {
    display: inline-block;
    margin-top: 4px;
    font-weight: var(--fw-semibold);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
  }
  .actions:empty {
    display: none;
  }
  .gallery {
    margin-bottom: var(--sp-6);
  }
  .gallery-grid {
    list-style: none;
    margin: var(--sp-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(160px, 100%), 1fr));
    gap: 10px;
  }
  .thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-sm);
    display: block;
    transition: transform var(--dur) var(--ease);
  }
  .gallery-grid a:hover .thumb {
    transform: scale(1.02);
  }
  .join {
    border-top: 1px solid var(--cbt-gri-10);
    padding-top: var(--sp-5);
  }
  .join p {
    margin: 0 0 var(--sp-3);
    color: var(--cbt-gri-60);
  }
</style>
