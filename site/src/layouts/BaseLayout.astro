---
/**
 * Scheletul fiecărei pagini: <head> complet pentru SEO (title, description, canonical,
 * Open Graph, hreflang, JSON-LD), navigație, subsol, banner cookie-uri și analytics.
 */
import '@fontsource-variable/onest';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ogDefault from '../assets/brand/og-default.png';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CookieBanner from '../components/CookieBanner.svelte';
import { t, pereche, type Lang } from '../i18n/ui';
import { GA_ID } from '../scripts/analytics';
import { SITE_NAME } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Limba activă în comutatorul RO/RU (diferă de `lang` doar pe /ru/ netradus). */
  comutator?: Lang;
  /** Imaginea pentru distribuire pe Facebook/Instagram/WhatsApp (1200×630 ideal). */
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article' | 'event';
  noindex?: boolean;
  /** Afișează banda „Versiunea în limba rusă este în pregătire”. */
  ruInPregatire?: boolean;
  /** Pereche de limbă pentru hreflang — doar când ambele versiuni sunt traduse. */
  alternate?: { ro: string; ru: string };
  jsonLd?: object | object[];
  /** Evenimentul GA de conversie trimis pe această pagină (pagini de mulțumire). */
  conversie?: string;
}

const {
  title,
  description,
  lang = 'ro',
  comutator = lang,
  image = ogDefault,
  imageAlt = SITE_NAME,
  type = 'website',
  noindex = false,
  ruInPregatire = false,
  alternate,
  jsonLd,
  conversie,
} = Astro.props;

const tr = t(lang);
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, Astro.site).href;
const fullTitle = path === '/' ? title : `${title} · CBT Timișoara`;

// Comutatorul RO/RU: dacă pagina are pereche, sare la ea; altfel la prima pagină a limbii.
const inversa = Object.fromEntries(Object.entries(pereche).map(([ro, ru]) => [ru, ro]));
const hrefRo = comutator === 'ro' ? path : (inversa[path] ?? '/');
const hrefRu = comutator === 'ru' ? path : (pereche[path] ?? '/ru/');

const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      alternate && (
        <>
          <link rel="alternate" hreflang="ro" href={new URL(alternate.ro, Astro.site).href} />
          <link rel="alternate" hreflang="ru" href={new URL(alternate.ru, Astro.site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(alternate.ro, Astro.site).href} />
        </>
      )
    }

    <!-- Open Graph: cum arată linkul distribuit pe Facebook, WhatsApp, Telegram -->
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'ro_RO'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#101010" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body data-conversie={conversie}>
    <a class="skip-link" href="#continut">{tr('skip')}</a>
    <SiteNav lang={lang} comutator={comutator} path={path} hrefRo={hrefRo} hrefRu={hrefRu} />
    {
      ruInPregatire && (
        <div class="ru-note" lang="ru">
          {tr('ru.inPregatire')}
        </div>
      )
    }
    <main id="continut">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    {GA_ID && <CookieBanner client:idle />}

    <script>
      import { initAnalytics } from '../scripts/analytics';
      initAnalytics();
    </script>
  </body>
</html>

<style>
  .ru-note {
    background: var(--cbt-albastru-10);
    color: var(--cbt-gri-90);
    font-size: var(--fs-small);
    text-align: center;
    padding: 10px clamp(16px, 4vw, 32px);
    border-bottom: 1px solid var(--cbt-gri-10);
  }
</style>
